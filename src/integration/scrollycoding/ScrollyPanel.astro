---
interface Props {
  index: string | number;
  count: string | number;
  title?: string;
  /** shiki's resolved theme colors, from the integration - see index.ts resolvePalette. */
  bg?: string;
  fg?: string;
}

const { index, count, title, bg, fg } = Astro.props;
const i = Number(index);
const n = Number(count);

// Only emitted when resolved, so the stylesheet's own defaults stay in play otherwise.
const palette = [bg && `--ch-bg:${bg}`, fg && `--ch-fg:${fg}`].filter(Boolean).join(";");
---

<div
  class="scrolly-panel"
  data-scrolly-panel
  data-index={i}
  data-selected={i === 0 ? "true" : "false"}
  style={`grid-row: 1 / span ${n};${palette}`}
>
  {title && <div class="scrolly-panel__name">{title}</div>}
  <slot />
</div>

<style>
  /* Everything the panel paints around the code is derived from shiki's own two colors,
     which arrive as --ch-bg/--ch-fg in the inline style above. The values here are only
     the fallback for when the theme couldn't be resolved (shiki's nord).

     Only the diff pair is left as fixed hues: red and green carry meaning rather than
     matching the theme, and they are alpha overlays, so they compose on any background. */
  .scrolly-panel {
    --ch-bg: #2e3440;
    --ch-fg: #d8dee9;

    /* Chrome sits just off the code background - enough to read as a separate surface
       without competing with the code itself. */
    --ch-chrome: color-mix(in srgb, var(--ch-bg) 86%, var(--ch-fg));
    --ch-chrome-fg: color-mix(in srgb, var(--ch-fg) 88%, var(--ch-bg));
    --ch-border: color-mix(in srgb, var(--ch-bg) 62%, var(--ch-fg));

    /* Marks are deliberately neutral rather than a hue of their own: the diff colors are
       the only thing in the panel that should read as semantic. Override --ch-accent on
       .scrolly-panel to give them a tint. */
    --ch-accent: color-mix(in srgb, var(--ch-fg) 65%, var(--ch-bg));
    --ch-accent-wash: color-mix(in srgb, var(--ch-fg) 13%, transparent);
    --ch-accent-wash-strong: color-mix(in srgb, var(--ch-fg) 22%, transparent);

    --ch-diff-add: #3fb950;
    --ch-diff-del: #f85149;

    grid-column: 2;
    position: sticky;
    top: var(--scrolly-top, 3rem);
    align-self: start;
    max-height: calc(100vh - 2 * var(--scrolly-top, 3rem));
    /* Keeps tall code reachable, and zeroes the item's automatic minimum size so a
       long panel can't inflate the step rows. */
    overflow: auto;
    border-radius: 4px;
  }

  /* Hidden with opacity, not display:none (every panel must keep contributing height to
     the shared grid area, so the sticky column doesn't jump, and so token positions stay
     measurable before a swap) and deliberately NOT with visibility.

     `visibility` is inherited, and toggling it on the panel leaves the computed value
     stale on descendants that have Web Animations attached - whole lines of tokens stay
     hidden after an interrupted swap, and nothing short of an inline style write on each
     token clears it. Measured: 14 of 48 interrupted swaps broke that way; 0 of 54 once
     visibility stopped toggling. opacity is not inherited, so it has no such effect.

     No opacity transition: the swap itself is instant, and the token animation in
     tokenTransitions.ts is what carries the eye across. */
  .scrolly-panel[data-selected="false"] {
    opacity: 0;
    pointer-events: none;
    user-select: none;
  }

  /* Every panel shares one grid area, so paint order would otherwise be DOM order and a
     dissolve would layer differently depending on which way the reader is scrolling.
     Raising the selected one keeps the incoming panel on top either way - see crossfade()
     in tokenTransitions.ts. */
  .scrolly-panel[data-selected="true"] {
    z-index: 1;
  }

  /* Transforms don't apply to non-replaced inline elements, so the syntax tokens have to
     be inline-block for the FLIP to move them. Callouts are excluded: they are not
     tokens, and this selector outranks `.ch-callout { display: block }`, which would
     otherwise leave the callout sitting inline at the end of its line. */
  .scrolly-panel :global(pre .line > span:not(.ch-callout)) {
    display: inline-block;
  }

  .scrolly-panel__name {
    font-family: Montserrat, sans-serif;
    font-size: 0.8rem;
    padding: 0.35rem 0.75rem;
    background: var(--ch-chrome);
    color: var(--ch-chrome-fg);
    border-radius: 4px 4px 0 0;
  }

  /* The <pre> is slotted MDX content, so it carries the post's scope. Let shiki's inline
     nord background show through and drop the global bottom margin. */
  .scrolly-panel :global(pre) {
    margin: 0;
    border-radius: 0 0 4px 4px;
  }

  .scrolly-panel__name + :global(pre) {
    border-radius: 0 0 4px 4px;
  }

  .scrolly-panel :global(.line.ch-mark) {
    display: inline-block;
    width: 100%;
    background: var(--ch-accent-wash);
    box-shadow: inset 3px 0 0 var(--ch-accent);
  }

  /* Inline ranges, from regex queries like `!mark[/home_axis/]`. Marked at whole-token
     granularity, so this highlights the tokens the range touches. */
  .scrolly-panel :global(.ch-mark-inline) {
    background: var(--ch-accent-wash-strong);
    border-radius: 3px;
    box-shadow: 0 0 0 1px var(--ch-border);
  }

  /* Gutter: line numbers and/or the diff sign, composed server-side into one string so
     the two stay aligned instead of fighting over the same pseudo-element. */
  .scrolly-panel :global(.line[data-ch-gutter]::before) {
    content: attr(data-ch-gutter);
    display: inline-block;
    white-space: pre;
    /* Left padding clears the diff bar, which is drawn inset on the line itself and
       would otherwise sit on top of the digits. Applied to every gutter, not just diff
       lines, so the columns stay aligned. */
    padding-left: 0.75ch;
    margin-right: 1.25ch;
    opacity: 0.4;
    user-select: none;
    -webkit-user-select: none;
  }

  .scrolly-panel :global(.line.ch-diff-add),
  .scrolly-panel :global(.line.ch-diff-del) {
    display: inline-block;
    width: 100%;
  }

  .scrolly-panel :global(.line.ch-diff-add) {
    background: color-mix(in srgb, var(--ch-diff-add) 16%, transparent);
    box-shadow: inset 3px 0 0 var(--ch-diff-add);
  }

  .scrolly-panel :global(.line.ch-diff-del) {
    background: color-mix(in srgb, var(--ch-diff-del) 16%, transparent);
    box-shadow: inset 3px 0 0 var(--ch-diff-del);
  }

  /* Code mentions: hovering a mention in the prose dims every line it doesn't name. */
  .scrolly-panel :global(.line) {
    transition: opacity 120ms linear;
  }

  .scrolly-panel :global(.line.ch-dim) {
    opacity: 0.3;
  }

  /* Focus: when a block has any !focus, everything else recedes. */
  .scrolly-panel :global(pre[data-ch-focus] .line:not(.ch-focus)) {
    opacity: 0.45;
  }

  /* Callouts hang under their line, so the line has to become a block box. */
  .scrolly-panel :global(.line.ch-has-callout) {
    display: inline-block;
    width: 100%;
  }

  .scrolly-panel :global(.ch-callout) {
    display: block;
    position: relative;
    width: fit-content;
    margin: 0.5em 0 0.25em;
    padding: 0.15em 0.7em;
    border: 1px solid var(--ch-border);
    border-radius: 4px;
    background: var(--ch-chrome);
    color: var(--ch-chrome-fg);
    white-space: break-spaces;
    user-select: none;
    -webkit-user-select: none;
  }

  .scrolly-panel :global(.ch-callout__arrow) {
    position: absolute;
    top: -1px;
    width: 8px;
    height: 8px;
    border-left: 1px solid var(--ch-border);
    border-top: 1px solid var(--ch-border);
    background: var(--ch-chrome);
    transform: rotate(45deg) translateY(-50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .scrolly-panel,
    .scrolly-panel :global(.line) {
      transition: none;
    }
  }

  @media (max-width: 60rem) {
    .scrolly-panel {
      position: static;
      max-height: none;
      overflow: visible;
      margin-bottom: var(--spacing-8, 2rem);
    }

    /* Must match the [data-selected='false'] specificity (0,2,0) or it loses. */
    .scrolly-panel[data-selected] {
      opacity: 1;
      pointer-events: auto;
      user-select: auto;
    }
  }
</style>
