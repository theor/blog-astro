---
interface Props {
  index: string | number;
  count: string | number;
  title?: string;
}

const { index, count, title } = Astro.props;
const i = Number(index);
const n = Number(count);
---

<div
  class="scrolly-panel"
  data-scrolly-panel
  data-index={i}
  data-selected={i === 0 ? "true" : "false"}
  style={`grid-row: 1 / span ${n};`}
>
  {title && <div class="scrolly-panel__name">{title}</div>}
  <slot />
</div>

<style>
  .scrolly-panel {
    grid-column: 2;
    position: sticky;
    top: var(--scrolly-top, 3rem);
    align-self: start;
    max-height: calc(100vh - 2 * var(--scrolly-top, 3rem));
    /* Keeps tall code reachable, and zeroes the item's automatic minimum size so a
       long panel can't inflate the step rows. */
    overflow: auto;
    border-radius: 4px;
  }

  /* Hidden with opacity, not display:none (every panel must keep contributing height to
     the shared grid area, so the sticky column doesn't jump, and so token positions stay
     measurable before a swap) and deliberately NOT with visibility.

     `visibility` is inherited, and toggling it on the panel leaves the computed value
     stale on descendants that have Web Animations attached - whole lines of tokens stay
     hidden after an interrupted swap, and nothing short of an inline style write on each
     token clears it. Measured: 14 of 48 interrupted swaps broke that way; 0 of 54 once
     visibility stopped toggling. opacity is not inherited, so it has no such effect.

     No opacity transition: the swap itself is instant, and the token animation in
     tokenTransitions.ts is what carries the eye across. */
  .scrolly-panel[data-selected="false"] {
    opacity: 0;
    pointer-events: none;
    user-select: none;
  }

  /* Transforms don't apply to non-replaced inline elements, so the syntax tokens have to
     be inline-block for the FLIP to move them. */
  .scrolly-panel :global(pre .line > span) {
    display: inline-block;
  }

  .scrolly-panel__name {
    font-family: Montserrat, sans-serif;
    font-size: 0.8rem;
    padding: 0.35rem 0.75rem;
    background: #3b4252;
    color: #d8dee9;
    border-radius: 4px 4px 0 0;
  }

  /* The <pre> is slotted MDX content, so it carries the post's scope. Let shiki's inline
     nord background show through and drop the global bottom margin. */
  .scrolly-panel :global(pre) {
    margin: 0;
    border-radius: 0 0 4px 4px;
  }

  .scrolly-panel__name + :global(pre) {
    border-radius: 0 0 4px 4px;
  }

  .scrolly-panel :global(.line.ch-mark) {
    display: inline-block;
    width: 100%;
    background: rgba(136, 192, 208, 0.16);
    box-shadow: inset 3px 0 0 #88c0d0;
  }

  /* Inline ranges, from regex queries like `!mark[/home_axis/]`. Marked at whole-token
     granularity, so this highlights the tokens the range touches. */
  .scrolly-panel :global(.ch-mark-inline) {
    background: rgba(136, 192, 208, 0.28);
    border-radius: 3px;
    box-shadow: 0 0 0 1px rgba(136, 192, 208, 0.5);
  }

  /* Gutter: line numbers and/or the diff sign, composed server-side into one string so
     the two stay aligned instead of fighting over the same pseudo-element. */
  .scrolly-panel :global(.line[data-ch-gutter]::before) {
    content: attr(data-ch-gutter);
    display: inline-block;
    white-space: pre;
    /* Left padding clears the diff bar, which is drawn inset on the line itself and
       would otherwise sit on top of the digits. Applied to every gutter, not just diff
       lines, so the columns stay aligned. */
    padding-left: 0.75ch;
    margin-right: 1.25ch;
    opacity: 0.4;
    user-select: none;
    -webkit-user-select: none;
  }

  .scrolly-panel :global(.line.ch-diff-add),
  .scrolly-panel :global(.line.ch-diff-del) {
    display: inline-block;
    width: 100%;
  }

  .scrolly-panel :global(.line.ch-diff-add) {
    background: rgba(63, 185, 80, 0.16);
    box-shadow: inset 3px 0 0 #3fb950;
  }

  .scrolly-panel :global(.line.ch-diff-del) {
    background: rgba(248, 81, 73, 0.16);
    box-shadow: inset 3px 0 0 #f85149;
  }

  /* Code mentions: hovering a mention in the prose dims every line it doesn't name. */
  .scrolly-panel :global(.line) {
    transition: opacity 120ms linear;
  }

  .scrolly-panel :global(.line.ch-dim) {
    opacity: 0.3;
  }

  @media (prefers-reduced-motion: reduce) {
    .scrolly-panel,
    .scrolly-panel :global(.line) {
      transition: none;
    }
  }

  @media (max-width: 60rem) {
    .scrolly-panel {
      position: static;
      max-height: none;
      overflow: visible;
      margin-bottom: var(--spacing-8, 2rem);
    }

    /* Must match the [data-selected='false'] specificity (0,2,0) or it loses. */
    .scrolly-panel[data-selected] {
      opacity: 1;
      pointer-events: auto;
      user-select: auto;
    }
  }
</style>
