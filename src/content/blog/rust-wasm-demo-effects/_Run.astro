---
const { height = "300px", title = "" } = Astro.props;
    import bg  from "./clouds.png?url";
    import tree  from "./CoconutTree.png?url";
    import planet  from "./Ice.png?url";

---
<style define:vars={{ wasmheight: height }}>
    div {
        min-height: var(--wasmheight);
    }
</style>
<div {...Astro.props} data-bg={bg} data-tree={tree} data-planet={planet} data-rust-demo>
</div>
{title && <span>{title}</span>}
<script>
    import {setup} from "./_rund";
    if(document.querySelectorAll("[data-rust-demo]").length > 0) {
        setup();
    }	
</script>
